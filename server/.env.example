# Core server configuration
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Database and authentication (required)
MONGO_URI=mongodb://127.0.0.1:27017/attendance-monitoring
JWT_SECRET=nenu_naa_sunandha
JWT_EXPIRES_IN=7d

# Registration codes
ADMIN_REGISTRATION_CODE=replace-with-admin-registration-code
TEACHER_REGISTRATION_CODE=replace-with-teacher-registration-code

# Local Excel attendance register
# Path is relative to the server directory unless an absolute path is used.
ATTENDANCE_WORKBOOK_PATH=data/attendance-register.xlsx

# Optional seed accounts
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_HOD_NAME=Department HOD
SEED_HOD_EMAIL=hod@example.com
SEED_HOD_PASSWORD=replace-with-a-strong-password
SEED_HOD_DEPARTMENT=CSE

# Optional Meta WhatsApp Business API notifications
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v20.0
NOTIFICATION_RETRY_LIMIT=3
NOTIFICATION_RETRY_INTERVAL_MS=600000
